
# Ignore lecture build outputs (except PDFs)
lectures/*/output/*
!lectures/*/output/slides.pdf

# Zotero attachments. These patterns are deliberately UNANCHORED (leading
# **/): a pattern containing a slash is matched relative to this file, so the
# old `bib/**/*.pdf` only ever covered the top-level bib/. The sync daemon
# resolves its output dir from its own cwd, so running it from scripts/syncing
# wrote to scripts/syncing/bib/ — which the anchored pattern could not see, and
# 16 MB of paper PDFs went in unnoticed. Match bib/ wherever it appears.
**/bib/**/*.pdf

# Ignore HTML snapshots
**/bib/**/*.html

# Ignore Zotero sync log
**/bib/.sync_log.txt

# ignore embeddings
embeddings/

# Ignore python env
.venv/

# ignore chapters
**/bib/*/chapters/

# Compiled python — five .pyc files had been committed under scripts/syncing/
__pycache__/
*.pyc

.secrets
*.out
sync.log

# Ignore cloned experiment repos (contents only, keep the folder)
experiments/**

# Jupyter checkpoints
.ipynb_checkpoints/

# ERRATA 2026-08-24: the RLHF notebook (06_rlhf) writes SFT/GRPO checkpoints next
# to itself - 4.2 GB of untracked files after one local run. Harmless on Colab,
# but the notebook runs locally too.
lectures/*/exercises/*/sft/
lectures/*/exercises/*/sft_model/
lectures/*/exercises/*/grpo/
